<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/page_margin_left"
        android:layout_marginRight="@dimen/page_margin_right"
        android:orientation="horizontal"
        android:visibility="invisible">

    <ImageView
            style="@style/Widget.DragShare.SelectionAction"
            android:id="@+id/all_search"
            android:layout_alignParentLeft="true"
            android:contentDescription="@string/bigbang_more_search"
            android:src="@drawable/ic_search" />

    <ImageView
            style="@style/Widget.DragShare.SelectionAction"
            android:id="@+id/all_dict"
            android:layout_toRightOf="@+id/all_search"
            android:contentDescription="@string/bigbang_more_dictionary"
            android:src="@drawable/ic_dictionary" />

    <ImageView
            style="@style/Widget.DragShare.SelectionAction"
            android:id="@+id/all_cut"
            android:layout_toRightOf="@+id/all_dict"
            android:contentDescription="@string/bigbang_more_split"
            android:src="@drawable/ic_text_segment" />

    <ImageView
            style="@style/Widget.DragShare.SelectionAction"
            android:id="@+id/all_share"
            android:layout_marginRight="4dp"
            android:layout_toLeftOf="@+id/all_copy"
            android:contentDescription="@string/bigbang_more_share"
            android:src="@drawable/ic_share" />

    <ImageView
            style="@style/Widget.DragShare.SelectionAction"
            android:id="@+id/all_copy"
            android:layout_alignParentRight="true"
            android:layout_marginRight="1dp"
            android:contentDescription="@string/bigbang_more_copy"
            android:src="@drawable/ic_copy" />
</RelativeLayout>
