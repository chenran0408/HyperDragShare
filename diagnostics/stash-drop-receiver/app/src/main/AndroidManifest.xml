<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="Stash Drop Probe" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name=".ImageProvider" android:authorities="com.leaf.dragdrop.probe.image" android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
